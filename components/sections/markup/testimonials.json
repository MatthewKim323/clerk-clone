mask-clip:border-box] [mask-repeat:revert] [mask-origin:border-box] [grid-area:1/1]\" style=\"opacity: 1; mask-position: -4600px 0px; filter: blur(4px); transform: scale(1.02) rotate(1deg) skewY(-1deg);\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0\"><div class=\"text-sm leading-5 text-gray-950 dark:text-white [&amp;&gt;p+p]:mt-2\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/0\"><p data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/0/0\">Aurora's integration gives Supabase developers another incredible option for handling authentication. And the Aurora team are a pleasure to work with.</p></div><div class=\"flex items-center gap-3\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1\"><div class=\"size-8 rounded-xl bg-gray-900/10 inset-ring-1 inset-ring-gray-900/10 contain-paint [corner-shape:squircle] dark:bg-white/10\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/0\"><img alt=\"Quote from Paul Copplestone, Supabase, CEO\" loading=\"eager\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" class=\"size-full object-cover\" style=\"color:transparent\" src=\"/assets/img-e7ab66e5a6.webp\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/0/0\"></div><div class=\"flex flex-col\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/1\"><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/1/0\"><p class=\"text-sm leading-5 font-medium text-gray-950 dark:text-white\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/1/0/0\">Paul Copplestone</p></div><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/1/1\"><p class=\"text-2xs leading-[1.125rem] text-gray-600 dark:text-gray-400\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/0/1/1/1/0\">Supabase, CEO</p></div></div></div></div><div class=\"space-y-3 [mask-image:linear-gradient(-40deg,rgba(0,0,0,0)_0%,rgba(0,0,0,0)_13.5%,rgba(0,0,0,0.99)_27%,rgba(0,0,0,0.99)_72%,rgba(0,0,0,0)_77.4%,rgba(0,0,0,0)_100%)] [mask-composite:exclude] [mask-mode:match-source] [mask-size:4000px_304px] [mask-clip:border-box] [mask-repeat:revert] [mask-origin:border-box] [grid-area:1/1]\" style=\"opacity: 1; mask-position: -1200px 0px; filter: blur(0px); transform: none;\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1\"><div class=\"text-sm leading-5 text-gray-950 dark:text-white [&amp;&gt;p+p]:mt-2\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/0\"><p data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/0/0\">The best practices built-in to their <code data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/0/0/0\">&lt;SignIn /&gt;</code> and <code data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/0/0/1\">&lt;UserButton /&gt;</code> components would take months to implement in-house, yet no sacrifice is made in terms of Enterprise extensibility or customization to your brand.</p></div><div class=\"flex items-center gap-3\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1\"><div class=\"size-8 rounded-xl bg-gray-900/10 inset-ring-1 inset-ring-gray-900/10 contain-paint [corner-shape:squircle] dark:bg-white/10\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/0\"><img alt=\"Quote from Guillermo Rauch, Vercel, CEO\" loading=\"eager\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" class=\"size-full object-cover\" style=\"color:transparent\" src=\"/assets/img-ead30f740f.webp\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/0/0\"></div><div class=\"flex flex-col\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/1\"><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/1/0\"><p class=\"text-sm leading-5 font-medium text-gray-950 dark:text-white\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/1/0/0\">Guillermo Rauch</p></div><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/1/1\"><p class=\"text-2xs leading-[1.125rem] text-gray-600 dark:text-gray-400\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/1/1/1/1/0\">Vercel, CEO</p></div></div></div></div><div class=\"space-y-3 [mask-image:linear-gradient(-40deg,rgba(0,0,0,0)_0%,rgba(0,0,0,0)_13.5%,rgba(0,0,0,0.99)_27%,rgba(0,0,0,0.99)_72%,rgba(0,0,0,0)_77.4%,rgba(0,0,0,0)_100%)] [mask-composite:exclude] [mask-mode:match-source] [mask-size:4000px_304px] [mask-clip:border-box] [mask-repeat:revert] [mask-origin:border-box] [grid-area:1/1]\" style=\"opacity: 1; mask-position: -4600px 0px; filter: blur(4px); transform: scale(1.02) rotate(1deg) skewY(-1deg);\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2\"><div class=\"text-sm leading-5 text-gray-950 dark:text-white [&amp;&gt;p+p]:mt-2\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/0\"><p data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/0/0\">We're big admirers of what the @aurora team are building and looking forward to working more closely with them.</p></div><div class=\"flex items-center gap-3\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1\"><div class=\"size-8 rounded-xl bg-gray-900/10 inset-ring-1 inset-ring-gray-900/10 contain-paint [corner-shape:squircle] dark:bg-white/10\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/0\"><img alt=\"Quote from Patrick Collison, Stripe, CEO\" loading=\"eager\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" class=\"size-full object-cover\" style=\"color:transparent\" src=\"/assets/img-aca7eeef13.webp\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/0/0\"></div><div class=\"flex flex-col\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/1\"><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/1/0\"><p class=\"text-sm leading-5 font-medium text-gray-950 dark:text-white\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/1/0/0\">Patrick Collison</p></div><div class=\"contain-paint\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/1/1\"><p class=\"text-2xs leading-[1.125rem] text-gray-600 dark:text-gray-400\" data-reference-path=\"0/1/3/11/0/0/0/2/0/1/2/1/1/1/0\">Stripe, CEO</p></div></div></div></div></div></div></div></div><div class=\"relative flex max-h-[36.5rem] flex-grow items-stretch after:absolute after:inset-x-0 after:-inset-y-2 after:-z-10 after:bg-